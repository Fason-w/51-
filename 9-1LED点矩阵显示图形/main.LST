   9          /**
  10            *@brief  74HC595写入的一个字节
  11            *@param  要写入的字节
  12            *@retval 无
  13            */
  14          
  15          void _74HC595_WriteByte(unsigned char Byte)
  16          {
  17   1              unsigned char i;
  18   1              for(i=0; i<8; i++)
  19   1              {
  20   2                      SER=Byte&(0x80>>i);
  21   2                      SCK=1;
  22   2                      SCK=0;
  23   2              }
  24   1                      RCK=1;
  25   1                      RCK=0;
  26   1      
  27   1      }
  28          
  29          /**
  30            *@brief  LED点阵屏显示一列数据
  31            *@param  Column 要选择的列，范围0~7
  32            *@param  Data 选择列显示的数据，高位在上，1为亮，0为灭
  33            *@retval 无
  34            */
  35          
  36          void MatrixLED_ShowColumn(unsigned char Column,Data)
  37          {
  38   1              _74HC595_WriteByte(Data);
  39   1              MATRIX_LED_PORT=~(0x80>>Column);
  40   1              Delay(1);
  41   1              MATRIX_LED_PORT=0xFF;   
  42   1      }
  43          
  44          void main()
  45          {
  46   1              SCK=0;
  47   1              RCK=0;
