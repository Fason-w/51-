  51   2                      MatrixLED_ShowColumn(1,0x42);
  52   2                      MatrixLED_ShowColumn(2,0xA9);
  53   2                      MatrixLED_ShowColumn(3,0x85);
  54   2      
  55   2                      MatrixLED_ShowColumn(4,0x85);
