   3          
   4          #define AT24C02_ADDRESS         0xA0
   5          
   6          /**
   7            *@brief  AT24C02写入一个字节
   8            *@param  WordAddress 要写入字节的地址
   9            *@param  Data 要写入的字节数据
  10            *@retval 无
  11            */void AT24C02_WriteByte(unsigned char WordAddress,Data)
  12          {
  13   1              I2C_Start();
  14   1              I2C_SendByte(AT24C02_ADDRESS);
  15   1              I2C_ReciveAck();
  16   1              I2C_SendByte(WordAddress);
  17   1              I2C_ReciveAck();
  18   1              I2C_SendByte(Data);
  19   1              I2C_ReciveAck();
  20   1              I2C_Stop();
  21   1      
  22   1      }
  23          
  24          /**
  25            *@brief       AT24C02读取一个字节
  26            *@param       WordAddress 要读取字节的地址
  27            *@retval      要读取的字节数据
  28            */
  29          unsigned char AT24C02_ReadByte(unsigned char WordAddress)
  30          {
  31   1              unsigned char Data=0;
  32   1              I2C_Start();
  33   1              I2C_SendByte(AT24C02_ADDRESS);
  34   1              I2C_ReciveAck();
  35   1              I2C_SendByte(WordAddress);
  36   1              I2C_ReciveAck();
  37   1              I2C_Start();
